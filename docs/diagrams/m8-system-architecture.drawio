          <mxGeometry x="40" y="24" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Legend&lt;/b&gt;&lt;/div&gt;&lt;ol style=&quot;padding-left:20px;margin-top:10px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Shoppers&lt;/b&gt; reach the node&#x27;s fixed Elastic IP on port 80, the only port open to everyone.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;The &lt;b&gt;internet gateway&lt;/b&gt; passes traffic to the public subnet, and the security group admits it.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Traefik&lt;/b&gt; routes every path to the Nginx Service.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Nginx&lt;/b&gt; serves the React build and forwards /api and /socket.io to the API.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;The &lt;b&gt;API&lt;/b&gt; reads MongoDB. A NetworkPolicy lets only the API and the seed job connect.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Filebeat&lt;/b&gt; reads the shop&#x27;s container logs from the node.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Logstash&lt;/b&gt; marks errors, &lt;b&gt;Elasticsearch&lt;/b&gt; stores them by day, and &lt;b&gt;Kibana&lt;/b&gt; searches them. All stay inside the cluster.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Prometheus&lt;/b&gt; scrapes nodes, pods and Traefik and evaluates the alert rules. &lt;b&gt;Grafana&lt;/b&gt; shows the dashboard.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Jenkins&lt;/b&gt; and &lt;b&gt;Helm&lt;/b&gt; deploy through port 6443. SSH and 6443 answer the admin address range only.&lt;/li&gt;&lt;/ol&gt;&lt;b&gt;Security&lt;/b&gt;&lt;ul style=&quot;padding-left:20px;margin-top:6px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;All shop containers run as non-root. The API and Nginx have a read-only root filesystem.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Secrets are generated at install and live in Kubernetes Secrets, never in git.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Grafana and Kibana are reached only through kubectl port-forward.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Build&lt;/b&gt;&lt;ul style=&quot;padding-left:20px;margin-top:6px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Terraform creates the network and the node, with its state in Amazon S3.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Ansible hardens the node and installs k3s.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;k3s pulls the images from the public GHCR packages.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1350" y="120" width="370" height="920" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
