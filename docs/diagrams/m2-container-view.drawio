          <mxGeometry x="662" y="355" width="196" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mongo" value="mongo: MongoDB 7.0&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;port 27017, not published&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="982" y="355" width="196" height="90" as="geometry" />
        </mxCell>
        <mxCell id="smoke" value="scripts/smoke-test.sh&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;same front door, exit 0 or 1&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="340" y="675" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="env" value="application/server/.env&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;read at start, never in the image&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="660" y="675" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vol" value="mongo-data&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5A6C86&quot;&gt;named volume&lt;/font&gt;&lt;/i&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;labelWidth=140;fontFamily=Arial;fontSize=12;fontColor=#232F3E;fillColor=#232F3D;shape=mxgraph.aws4.disk;" vertex="1" parent="1">
          <mxGeometry x="1056" y="686" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="step-1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="167" y="347" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="step-2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="427" y="313" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="step-3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="587" y="347" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="step-4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="907" y="347" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="step-5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1099" y="507" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="title" value="MERN shop on Docker Compose&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal&quot;&gt;M2 container view: local stack on WSL2, release v0.2.0&lt;/span&gt;" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Legend&lt;/b&gt;&lt;/div&gt;&lt;ol style=&quot;padding-left:20px;margin-top:10px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;The &lt;b&gt;web browser&lt;/b&gt; opens http://127.0.0.1:8080, the only published port. It is bound to loopback, so Docker&#x27;s own firewall rules cannot expose it to the network.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Nginx&lt;/b&gt; serves the React build itself: hashed JS and CSS cached for a year, index.html never cached, every React route sent to index.html.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Nginx&lt;/b&gt; forwards /api/ and /socket.io/ (with the WebSocket upgrade) to server:3000, found by name through Docker DNS.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;The &lt;b&gt;API&lt;/b&gt; reads and writes MongoDB at mongo:27017. Compose sets MONGO_URI to the service name.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;MongoDB&lt;/b&gt; keeps its files in the mongo-data named volume, so the data survives docker compose down.&lt;/li&gt;&lt;/ol&gt;&lt;b&gt;Security&lt;/b&gt;&lt;ul style=&quot;padding-left:20px;margin-top:6px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Both application containers run as non-root users (uid 1000 and 101) on root-owned code.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Secrets come from .env when the API starts and are never built into an image.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;MongoDB and the API are reachable from the other containers only.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Verification&lt;/b&gt;&lt;ul style=&quot;padding-left:20px;margin-top:6px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;smoke-test.sh checks the shop page, the database and the products through port 8080.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="130" width="310" height="660" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
