        <mxCell id="order" value="&lt;b&gt;Start order&lt;/b&gt; (depends_on: service_healthy):&amp;nbsp; mongo healthy (mongosh ping, 7.8 s)&amp;nbsp; &amp;rarr; &amp;nbsp;server healthy (/api/health, 13.4 s)&amp;nbsp; &amp;rarr; &amp;nbsp;client starts (13.7 s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=none;fontFamily=Arial;fontSize=12;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="236" width="850" height="44" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="Web browser&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#5A6C86&quot;&gt;Windows host&lt;/font&gt;&lt;/i&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=none;dashed=0;aspect=fixed;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;labelWidth=140;fontFamily=Arial;fontSize=12;fontColor=#232F3E;fillColor=#232F3D;shape=mxgraph.aws4.client;" vertex="1" parent="1">
