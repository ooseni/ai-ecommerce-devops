          <mxGeometry x="885" y="403" width="130" height="84" as="geometry" />
        </mxCell>
        <mxCell id="deploy" value="Deploy with Helm&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;rolled back
        if unhealthy&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="735" y="403" width="130" height="84" as="geometry" />
        </mxCell>
        <mxCell id="check" value="Post-deploy check&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;smoke test on the
        running shop&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="585" y="403" width="130" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ghcr" value="GitHub Container&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;Registry&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="975" y="588" width="150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="k3d" value="k3d on the laptop&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;from develop&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="650" y="588" width="140" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="k3s on Amazon EC2&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;from main&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="810" y="588" width="140" height="64" as="geometry" />
        </mxCell>
        <mxCell id="step-1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="177" y="209" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="step-2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="487" y="172" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="step-3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1119" y="317" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="step-4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="972" y="552" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="step-5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="787" y="549" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="title" value="CI/CD pipeline&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal&quot;&gt;From a pull request to running pods: every stage must pass before the next runs&lt;/span&gt;" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Legend&lt;/b&gt;&lt;/div&gt;&lt;ol style=&quot;padding-left:20px;margin-top:10px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;A &lt;b&gt;pull request&lt;/b&gt; is the only way into develop and main. Hooks scan each commit for secrets first.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Jenkins&lt;/b&gt; lints, scans the history for secrets, audits packages, builds both images and scans them. Each build is tagged with its commit SHA.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;The &lt;b&gt;smoke test&lt;/b&gt; runs those exact images in a throwaway stack, which is always removed.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;develop and main&lt;/b&gt; push to GHCR. Other branches stop here.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;Helm&lt;/b&gt; deploys: develop to k3d, main to EC2. A release that stays unhealthy is rolled back, and the post-deploy check tests the running shop.&lt;/li&gt;&lt;/ol&gt;&lt;b&gt;Gates&lt;/b&gt;&lt;ul style=&quot;padding-left:20px;margin-top:6px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Any secret in the history fails the build.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Vulnerability gates fail on a new critical finding or an unreadable report; known ones are in ci/security-baseline.env.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;A deliberately lowered baseline turned a build red and skipped every later stage.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1310" y="120" width="390" height="580" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
