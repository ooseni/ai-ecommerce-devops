          <mxGeometry x="735" y="208" width="130" height="84" as="geometry" />
        </mxCell>
        <mxCell id="build" value="Build images&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;tag = commit SHA&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="885" y="208" width="130" height="84" as="geometry" />
        </mxCell>
        <mxCell id="scan" value="Image scan&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;Trivy,
        baseline gate&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1035" y="208" width="130" height="84" as="geometry" />
        </mxCell>
        <mxCell id="smoke" value="Smoke test&lt;br&gt;&lt;font color=&quot;#5A6C86&quot;&gt;throwaway
        Compose stack&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=1.5;fontFamily=Arial;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
